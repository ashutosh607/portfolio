# Top-level gitignore protecting workspace secrets and build artifacts

# Environment files and credentials
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# Dependency directories
node_modules/
package-lock.json

# Build outputs
dist/
build/
.temp/
tmp/
uploads/

# Debug and system logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

