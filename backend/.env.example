# Server configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173,http://localhost:5174

# MongoDB Atlas URI (Replace <db_username> with your Atlas DB username)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.pluvu0q.mongodb.net/naruto_portfolio?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin Setup
ADMIN_EMAIL=your_email@example.com
ADMIN_INITIAL_PASSWORD=your_secure_password

