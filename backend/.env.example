# ==============================================================================
# SHINOBI PORTFOLIO BACKEND — RENDER PRODUCTION ENVIRONMENT VARIABLES
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-portfolio.vercel.app

# MongoDB Atlas URI (replace with your MongoDB Atlas connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/naruto_portfolio?retryWrites=true&w=majority

# 256-Bit JWT Secret Key for Session Authentication
JWT_SECRET=generate_or_paste_a_random_64_char_hex_secret_here
JWT_EXPIRES_IN=7d

# Cloudinary CDN (for media uploads from admin panel)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Initial Admin Credentials (for seed script)
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=YourStrongPasswordHere

